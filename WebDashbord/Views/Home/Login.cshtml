@{
    ViewBag.Title = "کاربرد کامپیوتر";
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
}


<div class="row">
    <div class="col-lg-6 PanelLeftLogin d-none d-lg-block">
        <div class="row" style="text-align:center;">
            <div class="col-lg-1 col-md-1 col-sm-1 col-xs-1"></div>
            <div class="col-lg-10 col-md-10 col-sm-10 col-xs-10">
                <img id="LogoLogin" src="~/Content/img/Login/LogoLogin.png" style="padding: 35% 20% 0% 20%; max-width:100%" />
                <div style="padding: 35% 20% 0% 20%;">
                    <p style="color: #fefefe;">کلیه حقوق این نرم افزار متعلق به شرکت مهندسی کاربرد کامپیوتر بوده و هر گونه نسخه برداری پیگرد قانونی دارد</p>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-6 " id="datalogin">
        <div class="row">
            <div class="col-lg-4 col-md-3 col-sm-2 col-xs-2"></div>
            <div class="col-lg-4 col-md-6 col-sm-8 col-xs-8">
                <div class="login-form" style="direction:rtl; padding-top: 100%">
                    <div class="col-sm-12">
                        <div class="form-group form-float ">
                            <div class="form-line focused fix">
                                <input type="text" id="userName" class="form-control" style="border-bottom: 1px solid #ec8121;text-indent: 20px;direction: rtl; color: #f3f4f3;" placeholder="نام کاربری" />
                                <img class="form-label" src="~/Content/img/Login/streamline-icon-single-man@48x48.png" width="16" height="16" />
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-12">
                        <div class="form-group form-float">
                            <div class="form-line focused fix">
                                <input type="password" id="password" class="form-control" placeholder="کلمه عبور" style="border-bottom: 1px solid #ec8121;text-indent: 20px;direction: rtl; color: #f3f4f3;" />
                                <img class="form-label" src="~/Content/img/Login/streamline-icon-lock-5@48x48.png" width="16" height="16" />
                            </div>
                        </div>
                    </div>
                    <div class="form-group btn-container" style="margin-top: 40px;margin-bottom: 0px;">
                        <button type="button" id ="LoginUser" class="btn btn-primary btn-block" style="background-color: #eb8121 !important;">ورود</button>
                    </div>
                    <div class="form-group" style="padding-top:100px;text-align: center;">
                            <a class="col-md-12 dropdown-toggle" data-toggle="modal" data-backdrop="static" data-keyboard="false" data-target="#modal-service" style="color: #fdfdfd;">
                                <img src="~/Content/img/Login/streamline-icon-add-circle-bold@48x48.png" width="16" height="16" />
                                <span>تنظیمات اتصال به وب</span>
                            </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="modalTwo modal modal-info fade" id="modal-service" aria-labelledby="formModal" aria-hidden="true">
    <div class="modal-dialog" style="width: 400px;">
        <div class="modal-content" style="background-color: #ededef;">
            <div class="modal-header"></div>
            <div class="modal-body">
                <div><h5 class="" style="text-align: center; padding: 25px;">تنظیمات اتصال به وب</h5></div>
                <div class="col-sm-12">
                    <div class="form-group form-float" style="  border: 1px solid white;
                                                                border-radius: 10px;
                                                                padding: 20px;
                                                                background-color: white;
                                                                box-shadow: 5px 5px 20px 1px #4048524f;">
                        <div class="form-line">
                            <input type="text" id="userAccount" placeholder="نام مجوز ورود" class="form-control login" style="border-bottom: 1px solid #ec8121;text-indent: 20px;direction: rtl;" />
                            <img class="form-label" src="~/Content/img/Login/streamline-icon-single-man@48x48.png" width="16" height="16" />
                        </div>
                    </div>
                </div>

                <div class="col-sm-12">
                    <div class="form-group form-float" style="  border: 1px solid white;
                                                                border-radius: 10px;
                                                                padding: 20px;
                                                                background-color: white;
                                                                box-shadow: 5px 5px 20px 1px #4048524f;">
                        <div class="form-line">
                            <input type="password" id="passAccount" placeholder="کلمه عبور" class="form-control login" style="border-bottom: 1px solid #ec8121;text-indent: 20px;direction: rtl;" placeholder="" />
                            <img class="form-label" src="~/Content/img/Login/streamline-icon-lock-5@48x48.png" width="16" height="16" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <div class="form-group btn-container" style="padding: 20px;">
                    <button type="button" class="btn btn-primary btn-block" id="LoginAccount" style="background-color: #eb8121 !important; margin-left:0px;">اتصال</button>
                </div>
            </div>
        </div>
    </div>

</div>


<div class="modalTwo modal modal-info fade" id="modal-dataUser">
    <div class="modal-dialog" style="width: 400px; direction: rtl;">
        <div class="modal-content" style="background-color: #ededef;">
            <div class="modal-header"></div>
            <div class="modal-body">
                <div>
                    <h5 id="title_dataUser" style="text-align: center; "></h5>
                </div>
                <div class="table-responsive">
                    <table class="table" style="text-align: start;">
                        <tbody>
                            <tr>
                                <th style="width:50%">ای پی</th>
                                <td id="param_ipw" style="direction:ltr"></td>
                            </tr>
                            <tr>
                                <th>تاریخ ورود</th>
                                <td id="param_date" style="direction:ltr"></td>
                            </tr>
                            <tr>
                                <th>ساعت ورود</th>
                                <td id="param_time" style="direction:ltr"></td>
                            </tr>
                            <tr>
                                <th>نام نرم افزار</th>
                                <td id="param_prog" style="direction: ltr;"></td>
                            </tr>
                            <tr>
                                <th>نسخه نرم افزار</th>
                                <td id="param_ver" style="direction:ltr"></td>
                            </tr>
                        </tbody>
                    </table>
                </div>

            </div>

            <div class="modal-footer">
                <div class="row col-md">
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6" style="padding-right: 8px;">
                        <button id="Login_LogOutUser"  class="btn btn-primary btn-block " style="background-color: #eb8121 !important; padding-left: 0px; padding-right: 0px">ورود</button>
                    </div>
                    <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6">
                        <button type="button" data-dismiss="modal" class="btn btn-primary btn-block" style="background-color: #eb8121 !important;  padding-left: 0px; padding-right: 0px">انصراف</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

