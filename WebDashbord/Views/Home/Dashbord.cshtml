@using WebDashbord.Controllers.Unit;
@{

    ViewBag.Title = "خانه";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row clearfix">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div id="objectGrid"></div>
        <div id="objectReport"></div>
        <div id="objectReport1"></div>

        <div class="card" style="box-shadow:none;position: sticky;">
            <div class="grid-stack" style="background: #f1f2f7;">
            </div>
        </div>
    </div>
</div>

<main></main>


<div id="objectModalSettingAll"></div>

<div class="modal fade" id="modal-DesktopItem" tabindex="-1" role="dialog" aria-labelledby="formModal" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button title="بستن" type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title">تنظیم آیتم ها</h4>
                <a id="NewItem" class="dropdown-toggle" data-toggle="modal" data-backdrop="static" data-target="#modal-DesktopNewItem" title="جدید">
                    <i class="bi bi-plus-circle"></i>
                </a>

            </div>
            <div class="modal-body">
                <div style="height:300px;overflow:auto;border: 1px #ddd solid;">
                    <table class="table">
                        <thead style="cursor: pointer;">
                            <tr>
                                <td>عنوان</td>
                                <td style="text-align: left;width: 0px;">
                                    <label>نمایش</label>
                                    <!-- <input id="AllSettingItem" type="checkbox" />-->
                                </td>
                            </tr>
                        </thead>
                        <tbody id="TableDesktopItem"></tbody>
                    </table>
                </div>
            </div>
            <div style="padding: 0px; margin: 10px;">
                <div class="row">
                    <div class="col-md-6">
                        <button type="button" id="DefultItems" class="btn btn-primary btn-block" style="background-color: #eb8121 !important;">پیش فرض</button>
                    </div>
                    <div class="col-md-6">
                        <button type="button" id="SaveItems" class="btn btn-primary btn-block" style="background-color: #eb8121 !important;">تایید</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modal-DesktopNewItem" tabindex="-1" role="dialog" aria-labelledby="formModal" aria-hidden="true">
    <div class="modal-dialog">
        <!--style="max-width:700px"-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title">افزودن آیتم</h4>
                <a></a>

            </div>
            <div class="modal-body">
                <div class="row" style="margin-bottom:1.5rem !important">
                    <span style="padding: 10px 0px 10px 5px;">گروه</span>
                    <select id="GroupDesktopItem" class="col"></select>
                    <span id="span_SalDesktopItem" style="padding: 10px">سال</span>
                    <select id="SalDesktopItem" class="col-3"></select>
                </div>

                <div class="row" style="margin-bottom:1.5rem !important">
                    <span style="padding: 10px 0px 10px 5px;">نوع</span>
                    <select id="ModeDesktopItem" class="col"></select>
                </div>

                <div class="row">
                    <div class="form-group form-float">
                        <div class="form-line focused date fix">
                            <input type="text" id="CaptionItem" class="form-control">
                            <label class="form-label active">عنوان</label>
                        </div>
                    </div>
                </div>

            </div>
            <div style="padding: 0px; margin: 10px;">
                <div class="row">
                    <div class="col-md-8"></div>
                    <div class="col-md">
                        <button type="button" id="AddItemDesktop" class="btn btn-primary btn-block" style="background-color: #eb8121 !important;">تایید</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>




